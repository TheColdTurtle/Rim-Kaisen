<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================================================================== -->
  <!-- Advanced / non-projectile technique types backed by custom C# Ability    -->
  <!-- classes: a toggle self-buff, a self-heal, and a shikigami summon.         -->
  <!-- These cast through the standard cast job (no verbProperties); the C#       -->
  <!-- class's Start()/toggle drives the effect.                                  -->
  <!-- ===================================================================== -->

  <!-- ===== Flowing Red Scale (added to the Blood Manipulation tree) ===== -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_BloodManipulationBase">
    <defName>JJK_FlowingRedScale</defName>
    <label>flowing red scale</label>
    <description>Toggle: flood the body with cursed blood, boosting melee damage and movement speed. Reserves cursed energy while active.</description>
    <uiPosition>(0.5, 0.6)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/FlowingRedScale</uiSkillIcon>
    <abilityClass>JJKMod.Ability_FlowingRedScale</abilityClass>
    <abilityTiers>
      <li>JJK_FlowingRedScale_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_FlowingRedScale_Tier1</defName>
    <label>flowing red scale</label>
    <acquireRequirement>
      <minLevel>1</minLevel>
      <requiredGenes>
        <li>JJK_CT_Gene_BloodManipulation</li>
      </requiredGenes>
    </acquireRequirement>
    <maxEnergyOffset>-20</maxEnergyOffset>
    <cooldownTicks>60</cooldownTicks>
  </TaranMagicFramework.AbilityTierDef>

  <!-- ===================== Reverse Cursed Technique ===================== -->
  <TaranMagicFramework.AbilityTreeDef>
    <defName>JJK_CT_RCT</defName>
    <label>reverse cursed technique</label>
    <unlockedByDefault>false</unlockedByDefault>
  </TaranMagicFramework.AbilityTreeDef>

  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase">
    <defName>JJK_ReverseCursedTechnique</defName>
    <label>reverse cursed technique</label>
    <description>Multiply two flows of cursed energy into a positive output, healing your own injuries. The amount healed scales with your sorcerer grade.</description>
    <uiPosition>(0.5, 0.5)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/ReverseCursedTechnique</uiSkillIcon>
    <abilityClass>JJKMod.Ability_ReverseCursedTechnique</abilityClass>
    <abilityTrees>
      <li>JJK_CT_RCT</li>
    </abilityTrees>
    <abilityTiers>
      <li>JJK_ReverseCursedTechnique_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_ReverseCursedTechnique_Tier1</defName>
    <label>reverse cursed technique</label>
    <!-- No trait listed here on purpose: the RCT TREE is what a trait unlocks
         (JJK_RCT or JJK_SoulMender), so reaching this def at all already proves
         the pawn has one of them. Gating on JJK_RCT specifically would lock a
         soul mender out of healing themselves. -->
    <acquireRequirement>
      <minLevel>0</minLevel>
    </acquireRequirement>
    <energyCost>50</energyCost>
    <cooldownTicks>600</cooldownTicks>
  </TaranMagicFramework.AbilityTierDef>

  <!-- RCT turned outward: the soul mender's gift. Deliberately inefficient
       compared to the self-heal - 20 healing for 80 energy (0.25 per point)
       against the self heal's 25 for 50 (0.5 per point) - on a longer
       cooldown, a slower cast, and only at a touch. -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase">
    <defName>JJK_ReverseCursedTechniqueOther</defName>
    <label>reverse cursed technique: mend</label>
    <description>Lay hands on another pawn and knit their wounds shut with reversed cursed energy - the rare gift of a soul mender.\n\nReversing your energy inside a body that is not your own is far harder than mending yourself: each cast closes less of the wound, costs far more cursed energy, and is slow to recover. Touch range. The amount healed scales with your sorcerer grade.</description>
    <uiPosition>(0.7, 0.5)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/ReverseCursedTechniqueOther</uiSkillIcon>
    <abilityClass>JJKMod.Ability_ReverseCursedTechniqueOther</abilityClass>
    <abilityTrees>
      <li>JJK_CT_RCT</li>
    </abilityTrees>
    <abilityTiers>
      <li>JJK_ReverseCursedTechniqueOther_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_ReverseCursedTechniqueOther_Tier1</defName>
    <label>reverse cursed technique: mend</label>
    <!-- Only a soul mender ever gets this one. -->
    <acquireRequirement>
      <requiredTraits>
        <li>JJK_SoulMender</li>
      </requiredTraits>
    </acquireRequirement>
    <energyCost>80</energyCost>
    <cooldownTicks>900</cooldownTicks>
    <castDurationTicks>60</castDurationTicks>
    <effectRadius>1.9</effectRadius>
    <requireLineOfSight>true</requireLineOfSight>
    <targetingParameters>
      <canTargetPawns>true</canTargetPawns>
      <canTargetLocations>false</canTargetLocations>
      <canTargetSelf>false</canTargetSelf>
      <canTargetAnimals>true</canTargetAnimals>
    </targetingParameters>
  </TaranMagicFramework.AbilityTierDef>

