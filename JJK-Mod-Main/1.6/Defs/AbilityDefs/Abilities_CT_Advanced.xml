  <TaranMagicFramework.AbilityDef ParentName="JJK_TenShadowsSummonBase">
    <defName>JJK_SummonDivineDogWhite</defName>
    <label>divine dog: white</label>
    <description>Summon the white Divine Dog - a fast melee hound bound to you. If the black dog has been lost, the white is summoned in its stronger Totality form. Only one of each shadow may be active at a time.</description>
    <uiPosition>(0.3, 0.3)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/DivineDogWhite</uiSkillIcon>
    <modExtensions>
      <li Class="JJKMod.ShikigamiAbilityExtension">
        <shikigami>JJK_Shadow_DivineDogWhite</shikigami>
      </li>
    </modExtensions>
