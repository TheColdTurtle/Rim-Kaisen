  <!-- Mahoraga (Calamity-grade; the adaptive divine general) -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_TenShadowsSummonBase">
    <defName>JJK_SummonMahoraga</defName>
    <label>mahoraga</label>
    <description>Summon the Eight-Handled Sword Divergent Sila Divine General Mahoraga. The first summon is hostile and must be defeated. Every wheel spin completely heals it. Basic physical attacks cannot kill it after their first adaptation, while complex techniques remain dangerous until fully adapted. It learns cursed phenomena separately from bullets, blades and explosions, and can adapt to control effects and Infinity through exposure. Adaptations reset when recalled and summoned again. Requires Calamity grade.</description>
    <uiPosition>(0.5, 0.9)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/Mahoraga</uiSkillIcon>
    <modExtensions>
      <li Class="JJKMod.ShikigamiAbilityExtension">
        <shikigami>JJK_Shadow_Mahoraga</shikigami>
      </li>
    </modExtensions>
    <abilityTiers>
