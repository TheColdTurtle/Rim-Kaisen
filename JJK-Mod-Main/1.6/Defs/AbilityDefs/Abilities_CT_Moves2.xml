<Defs>

  <!-- ===================================================================== -->
  <!-- Signature moves added to EXISTING techniques (canon movesets):           -->
  <!--   Disaster Flames  - Maximum: Meteor (Jogo's grade-1 nuke)               -->
  <!--   Shrine           - Divine Flame (Sukuna's fire arrow)                  -->
  <!--   Blood Manip.     - Supernova (blood burst)                             -->
  <!--   Cursed Speech    - "Explode" (the heaviest word)                       -->
  <!--   Projection       - Frame Freeze, Top Speed Punch                       -->
  <!--   Ratio            - Line Segment (7:3 mark)                             -->
  <!--   Ten Shadows      - Piercing Ox summon                                  -->
  <!--   Star Rage        - Garuda summon                                       -->
  <!-- ===================================================================== -->

  <!-- ====================== Maximum: Meteor (Flames) ===================== -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_DisasterFlamesBase">
    <defName>JJK_MaximumMeteor</defName>
    <label>maximum: meteor</label>
    <description>Call down Jogo's Maximum: Meteor. A marked 4.8-cell blast zone gives everyone four seconds to escape before impact deals 90 base explosive damage. The meteor can damage allies, the caster and structures, and remains armed if the caster falls.</description>
    <uiPosition>(0.5, 0.6)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/MaximumMeteor</uiSkillIcon>
    <abilityClass>JJKMod.Ability_LegacyTechnique</abilityClass>
    <modExtensions>
      <li Class="JJKMod.LegacyMoveExtension"><move>Meteor</move><radius>4.8</radius></li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_MaximumMeteor_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_MaximumMeteor_Tier1</defName>
    <label>maximum: meteor</label>
    <acquireRequirement>
      <minLevel>3</minLevel>
      <requiredGenes>
        <li>JJK_CT_Gene_DisasterFlames</li>
      </requiredGenes>
    </acquireRequirement>
    <energyCost>150</energyCost>
    <cooldownTicks>2500</cooldownTicks>
    <aiAbilityWorker>TaranMagicFramework.AIAbilityWorker_TargetHostile</aiAbilityWorker>
    <castDurationTicks>90</castDurationTicks>
    <effectRadius>26</effectRadius>
    <requireLineOfSight>true</requireLineOfSight>
    <targetingParameters>
      <canTargetPawns>true</canTargetPawns><canTargetLocations>true</canTargetLocations>
      <canTargetSelf>false</canTargetSelf>
    </targetingParameters>
  </TaranMagicFramework.AbilityTierDef>

  <!-- ======================= Divine Flame (Shrine) ======================= -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_ShrineBase">
    <defName>JJK_DivineFlame</defName>
    <label>divine flame: open</label>
    <description>Mold cursed flame into an arrow and loose it - the fire element of Shrine, revealed with the word "open". The arrow burns through armor and sets the impact site ablaze.</description>
    <uiPosition>(0.5, 0.6)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/DivineFlame</uiSkillIcon>
    <abilityTiers>
      <li>JJK_DivineFlame_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_DivineFlame_Tier1</defName>
    <label>divine flame: open</label>
    <acquireRequirement>
      <minLevel>3</minLevel>
      <requiredGenes>
        <li>JJK_CT_Gene_Shrine</li>
      </requiredGenes>
    </acquireRequirement>
    <energyCost>80</energyCost>
    <cooldownTicks>900</cooldownTicks>
    <aiAbilityWorker>TaranMagicFramework.AIAbilityWorker_TargetHostile</aiAbilityWorker>
    <verbProperties>
      <li Class="TaranMagicFramework.VerbPropertiesAbility">
        <verbClass>TaranMagicFramework.Verb_ShootAbility</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>JJK_Proj_DivineFlame</defaultProjectile>
        <range>24</range>
        <warmupTime>0.8</warmupTime>
        <targetParams>
          <canTargetPawns>true</canTargetPawns>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      </li>
    </verbProperties>
  </TaranMagicFramework.AbilityTierDef>

  <!-- ========================= Supernova (Blood) ========================= -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_BloodManipulationBase">
    <defName>JJK_Supernova</defName>
    <label>supernova</label>
    <description>Detonate compressed blood after a 1.5-second warning, dealing 36 base cutting damage in a 3-cell radius. Consumes Convergence, if prepared, to raise base damage to 50 and radius to 4 cells. Droplets can hit allies and the caster. This advanced application was developed by Choso.</description>
    <uiPosition>(0.3, 0.6)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/Supernova</uiSkillIcon>
    <abilityClass>JJKMod.Ability_LegacyTechnique</abilityClass>
    <modExtensions>
      <li Class="JJKMod.LegacyMoveExtension"><move>Supernova</move><radius>3</radius></li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_Supernova_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_Supernova_Tier1</defName>
    <label>supernova</label>
    <acquireRequirement>
      <minLevel>3</minLevel>
      <requiredGenes>
        <li>JJK_CT_Gene_BloodManipulation</li>
      </requiredGenes>
    </acquireRequirement>
    <energyCost>75</energyCost>
    <cooldownTicks>800</cooldownTicks>
    <aiAbilityWorker>TaranMagicFramework.AIAbilityWorker_TargetHostile</aiAbilityWorker>
    <castDurationTicks>42</castDurationTicks>
    <effectRadius>18</effectRadius>
    <requireLineOfSight>true</requireLineOfSight>
    <targetingParameters>
      <canTargetPawns>true</canTargetPawns><canTargetLocations>true</canTargetLocations>
      <canTargetSelf>false</canTargetSelf>
    </targetingParameters>
  </TaranMagicFramework.AbilityTierDef>

  <!-- ====================== "Explode" (Cursed Speech) ==================== -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_CursedSpeechBase">
    <defName>JJK_Speech_Explode</defName>
    <label>cursed speech: explode</label>
    <description>Scream the heaviest of the cursed words. The listener's own body detonates from within, tearing them apart and battering everything beside them. A word this monstrous savages the speaker's tongue.</description>
    <uiPosition>(0.5, 0.55)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/Explode</uiSkillIcon>
    <abilityClass>JJKMod.Ability_SpeechExplode</abilityClass>
    <modExtensions>
      <li Class="JJKMod.CursedSpeechExtension">
        <voiceStrain>3</voiceStrain>
      </li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_Speech_Explode_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_Speech_Explode_Tier1</defName>
    <label>cursed speech: explode</label>
    <acquireRequirement>
      <minLevel>3</minLevel>
      <requiredGenes>
        <li>JJK_CT_Gene_CursedSpeech</li>
      </requiredGenes>
    </acquireRequirement>
    <energyCost>75</energyCost>
    <cooldownTicks>900</cooldownTicks>
