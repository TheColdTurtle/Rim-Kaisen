  <!-- ======================== Line Segment (Ratio) ======================= -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_RatioBase">
    <defName>JJK_LineSegment</defName>
    <label>line segment</label>
    <description>Divide the target with lines and force a weak point open at the 7:3 ratio. While the mark lasts, everything the target takes strikes deeper. Recast to refresh the mark.</description>
    <uiPosition>(0.2, 0.3)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/LineSegment</uiSkillIcon>
    <abilityClass>JJKMod.Ability_LineSegment</abilityClass>
    <abilityTiers>
      <li>JJK_LineSegment_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_LineSegment_Tier1</defName>
    <label>line segment</label>
    <acquireRequirement>
      <requiredGenes>
        <li>JJK_CT_Gene_Ratio</li>
      </requiredGenes>
    </acquireRequirement>
    <energyCost>10</energyCost>
    <cooldownTicks>120</cooldownTicks>
    <castDurationTicks>10</castDurationTicks>
    <effectRadius>12</effectRadius>
    <requireLineOfSight>true</requireLineOfSight>
    <aiAbilityWorker>TaranMagicFramework.AIAbilityWorker_TargetHostile</aiAbilityWorker>
    <targetingParameters>
      <canTargetPawns>true</canTargetPawns>
      <canTargetLocations>false</canTargetLocations>
      <canTargetSelf>false</canTargetSelf>
    </targetingParameters>
  </TaranMagicFramework.AbilityTierDef>

  <!-- The 7:3 mark: everything hits the forced weak point. -->
  <HediffDef>
    <defName>JJK_RatioMark</defName>
    <label>7:3 ratio mark</label>
    <description>A weak point has been forced open on this body at the 7:3 ratio point. Until the mark fades, every blow strikes deeper.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>1.3</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- =================== Piercing Ox (Ten Shadows) ======================= -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_TenShadowsSummonBase">
    <defName>JJK_SummonPiercingOx</defName>
    <label>piercing ox</label>
    <description>Summon the Piercing Ox - a shikigami that builds momentum as it charges, driving its horns through anything in its path. First summon is hostile until defeated. A tamed Piercing Ox that dies is lost forever.</description>
    <uiPosition>(0.3, 0.9)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/PiercingOx</uiSkillIcon>
    <modExtensions>
      <li Class="JJKMod.ShikigamiAbilityExtension">
        <shikigami>JJK_Shadow_PiercingOx</shikigami>
      </li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_SummonPiercingOx_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_SummonPiercingOx_Tier1</defName>
    <label>piercing ox</label>
    <acquireRequirement>
      <minLevel>1</minLevel>
      <requiredGenes>
        <li>JJK_CT_Gene_TenShadows</li>
      </requiredGenes>
    </acquireRequirement>
    <energyCost>55</energyCost>
    <cooldownTicks>1500</cooldownTicks>
  </TaranMagicFramework.AbilityTierDef>

  <!-- ======================== Garuda (Star Rage) ========================= -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase">
    <defName>JJK_SummonGaruda</defName>
    <label>garuda</label>
    <description>Manifest Garuda, the shikigami bound to the Star Rage technique. It fights at your side, its strikes carrying the same virtual mass as its master's. Unlike the Ten Shadows, Garuda always answers - it needs no taming.</description>
    <uiPosition>(0.5, 0.55)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/Garuda</uiSkillIcon>
    <abilityClass>JJKMod.Ability_SummonShadow</abilityClass>
    <abilityTrees>
      <li>JJK_CT_StarRage</li>
    </abilityTrees>
    <modExtensions>
      <li Class="JJKMod.ShikigamiAbilityExtension">
        <shikigami>JJK_Shadow_Garuda</shikigami>
      </li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_SummonGaruda_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_SummonGaruda_Tier1</defName>
    <label>garuda</label>
    <acquireRequirement>
      <minLevel>1</minLevel>
      <requiredGenes>
        <li>JJK_CT_Gene_StarRage</li>
      </requiredGenes>
    </acquireRequirement>
    <energyCost>50</energyCost>
    <cooldownTicks>1200</cooldownTicks>
  </TaranMagicFramework.AbilityTierDef>

</Defs>
