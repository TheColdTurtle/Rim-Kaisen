  <!-- =================== Top Speed Punch (Projection) ==================== -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase">
    <defName>JJK_TopSpeedPunch</defName>
    <label>top speed punch</label>
    <description>Accelerate through the frames and arrive already mid-swing - blink to the target and drive a single devastating blow into it before it can react.</description>
    <uiPosition>(0.7, 0.55)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/TopSpeedPunch</uiSkillIcon>
    <abilityClass>JJKMod.Ability_TopSpeedPunch</abilityClass>
    <abilityTrees>
      <li>JJK_CT_Projection</li>
    </abilityTrees>
    <abilityTiers>
      <li>JJK_TopSpeedPunch_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_TopSpeedPunch_Tier1</defName>
