  </TaranMagicFramework.AbilityTierDef>

  <!-- ===================== Frame Freeze (Projection) ===================== -->
  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase">
    <defName>JJK_FrameFreeze</defName>
    <label>frame freeze</label>
    <description>Trap a target between the frames: anyone who breaks Projection Sorcery's 24-frame rule is frozen stiff for a moment. Instant, but short-lived.</description>
    <uiPosition>(0.3, 0.55)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/FrameFreeze</uiSkillIcon>
    <abilityClass>JJKMod.Ability_StunTarget</abilityClass>
    <abilityTrees>
      <li>JJK_CT_Projection</li>
    </abilityTrees>
    <modExtensions>
      <li Class="JJKMod.StunAbilityExtension">
        <stunTicks>90</stunTicks>
      </li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_FrameFreeze_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_FrameFreeze_Tier1</defName>
    <label>frame freeze</label>
    <acquireRequirement>
      <requiredGenes>
        <li>JJK_CT_Gene_Projection</li>
      </requiredGenes>
    </acquireRequirement>
