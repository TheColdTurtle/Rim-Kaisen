        <warmupTime>0.5</warmupTime>
        <targetParams>
          <canTargetPawns>true</canTargetPawns>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      </li>
    </verbProperties>
  </TaranMagicFramework.AbilityTierDef>

  <TaranMagicFramework.AbilityDef ParentName="JJK_DisasterFlamesBase">
    <defName>JJK_LavaLaser</defName>
    <label>volcanic lance</label>
    <description>Drive a narrow lance of volcanic heat through enemies along the line to the selected point. Stops at solid cover. Deals 28 base burn damage per enemy; line up targets to make the most of one cast.</description>
    <uiPosition>(0.5, 0.3)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/LavaLaser</uiSkillIcon>
    <abilityClass>JJKMod.Ability_LegacyTechnique</abilityClass>
    <modExtensions>
      <li Class="JJKMod.LegacyMoveExtension"><move>LavaLance</move><radius>0</radius></li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_LavaLaser_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_LavaLaser_Tier1</defName>
    <label>volcanic lance</label>
    <acquireRequirement>
