  <TaranMagicFramework.AbilityDef ParentName="JJK_ShrineBase">
    <defName>JJK_Cleave</defName>
    <label>cleave</label>
    <description>Touch an enemy and adapt a cutting attack to its toughness. Deals 24-48 base damage depending on armor and body size, with high armor penetration. Technique output scales the result. Requires contact range and cannot guarantee a kill against stronger opponents.</description>
    <uiPosition>(0.5, 0.3)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/Cleave</uiSkillIcon>
    <abilityClass>JJKMod.Ability_LegacyTechnique</abilityClass>
