<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================================================================== -->
  <!-- Cursed technique library (basic tier). Legacy moves use custom C#   -->
  <!-- on TaranMagicFramework.Ability + Verb_ShootAbility. Single-target moves   -->
  <!-- fire a bullet projectile; AoE moves fire a Projectile_Explosive.          -->
  <!--                                                                          -->
  <!-- Each technique is one AbilityTreeDef (registered in JJK_CursedTechniques  -->
  <!-- and granted by a CT gene). Each move within it is a separate AbilityDef   -->
  <!-- (= one gizmo) and gates on acquireRequirement > requiredGenes.            -->
  <!-- ===================================================================== -->

  <!-- ===================================================================== -->
  <!-- DISASTER FLAMES (Jogo)                                                  -->
  <!-- ===================================================================== -->
  <TaranMagicFramework.AbilityTreeDef>
    <defName>JJK_CT_DisasterFlames</defName>
    <label>disaster flames</label>
    <unlockedByDefault>false</unlockedByDefault>
  </TaranMagicFramework.AbilityTreeDef>

  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase" Name="JJK_DisasterFlamesBase" Abstract="True">
    <abilityClass>TaranMagicFramework.Ability</abilityClass>
    <abilityTrees>
      <li>JJK_CT_DisasterFlames</li>
    </abilityTrees>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityDef ParentName="JJK_DisasterFlamesBase">
    <defName>JJK_DisasterFlames</defName>
    <label>disaster flames</label>
    <description>Hurl a ball of cursed flame that burns whatever it strikes. The innate technique of the disaster curse Jogo.</description>
    <uiPosition>(0.3, 0.3)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/DisasterFlames</uiSkillIcon>
    <abilityTiers>
      <li>JJK_DisasterFlames_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_DisasterFlames_Tier1</defName>
    <label>disaster flames</label>
    <acquireRequirement>
      <requiredGenes>
        <li>JJK_CT_Gene_DisasterFlames</li>
      </requiredGenes>
    </acquireRequirement>
    <energyCost>35</energyCost>
    <cooldownTicks>240</cooldownTicks>
    <aiAbilityWorker>TaranMagicFramework.AIAbilityWorker_TargetHostile</aiAbilityWorker>
