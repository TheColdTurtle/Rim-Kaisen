    </targetingParameters>
  </TaranMagicFramework.AbilityTierDef>

  <TaranMagicFramework.AbilityDef ParentName="JJK_DisasterTidesBase">
    <defName>JJK_DeathSwarm</defName>
    <label>death swarm</label>
    <description>Establish a fixed aquatic hunting ground. After 0.75 seconds, launch six volleys one second apart, each sending a visible fish at up to three nearby enemies for 7 base bite damage per fish. Fish can be evaded or intercepted by cover; this extension has no domain sure-hit. One swarm per caster; losing the technique or becoming unable to sustain it ends the swarm.</description>
    <uiPosition>(0.6, 0.3)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/DeathSwarm</uiSkillIcon>
    <abilityClass>JJKMod.Ability_LegacyTechnique</abilityClass>
    <modExtensions>
      <li Class="JJKMod.LegacyMoveExtension"><move>DeathSwarm</move><radius>4.5</radius></li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_DeathSwarm_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

