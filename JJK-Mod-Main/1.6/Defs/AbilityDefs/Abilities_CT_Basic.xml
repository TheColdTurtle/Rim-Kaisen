    <cooldownTicks>180</cooldownTicks>
    <aiAbilityWorker>TaranMagicFramework.AIAbilityWorker_TargetHostile</aiAbilityWorker>
    <castDurationTicks>35</castDurationTicks>
    <effectRadius>26</effectRadius>
    <requireLineOfSight>true</requireLineOfSight>
    <targetingParameters>
      <canTargetPawns>true</canTargetPawns><canTargetLocations>true</canTargetLocations>
      <canTargetSelf>false</canTargetSelf>
    </targetingParameters>
  </TaranMagicFramework.AbilityTierDef>

  <TaranMagicFramework.AbilityDef ParentName="JJK_DisasterFlamesBase">
    <defName>JJK_EmberBurst</defName>
    <label>ember insects</label>
    <description>Send Ember Insects to a fixed location. Their sound briefly stuns nearby enemies for half a second, then the insects explode 1.5 seconds later for 38 base flame damage in a 3.2-cell radius. The blast can hit allies and the caster; enemies can escape the marked zone.</description>
    <uiPosition>(0.7, 0.3)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/EmberBurst</uiSkillIcon>
    <abilityClass>JJKMod.Ability_LegacyTechnique</abilityClass>
    <modExtensions>
      <li Class="JJKMod.LegacyMoveExtension"><move>EmberInsects</move><radius>3.2</radius></li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_EmberBurst_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_EmberBurst_Tier1</defName>
    <label>ember insects</label>
    <acquireRequirement>
      <minLevel>2</minLevel>
      <requiredGenes>
        <li>JJK_CT_Gene_DisasterFlames</li>
      </requiredGenes>
