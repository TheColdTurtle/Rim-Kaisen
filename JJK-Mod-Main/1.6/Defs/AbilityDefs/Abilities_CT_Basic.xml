  <TaranMagicFramework.AbilityDef ParentName="JJK_DisasterTidesBase">
    <defName>JJK_DisasterTides</defName>
    <label>water torrent</label>
    <description>Crash a wave into a 2.5-cell area for 24 base blunt damage. Enemies are pushed up to three cells away from the caster and slowed by 25% for 2.5 seconds. Walls and occupied cells stop the push. Use the wave to peel attackers away or drive them into a waiting swarm.</description>
    <uiPosition>(0.4, 0.3)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/DisasterTides</uiSkillIcon>
    <abilityClass>JJKMod.Ability_LegacyTechnique</abilityClass>
    <modExtensions>
      <li Class="JJKMod.LegacyMoveExtension"><move>Torrent</move><radius>2.5</radius></li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_DisasterTides_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>

  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_DisasterTides_Tier1</defName>
    <label>water torrent</label>
    <acquireRequirement>
      <requiredGenes>
        <li>JJK_CT_Gene_DisasterTides</li>
      </requiredGenes>
