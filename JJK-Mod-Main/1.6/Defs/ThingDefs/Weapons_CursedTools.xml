<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================================================================== -->
  <!-- Cursed Tools (Section 27). Only the three Standard tools (blade/spear/axe) -->
  <!-- are craftable; every named tool is drop/quest-only and must explicitly say -->
  <!-- <recipeMaker IsNull="True"/>, because vanilla's BaseMeleeWeapon chain      -->
  <!-- otherwise hands it a working, COSTLESS Smithy recipe. They can be spawned  -->
  <!-- for testing via the dev tools. All cursed tools carry Comp_CursedTool,    -->
  <!-- which makes their hits scale with the wielder's CT Output (sorcerer       -->
  <!-- grade) and deal bonus damage to cursed spirits (Patch_CursedTool).        -->
  <!-- ===================================================================== -->

  <ThingDef Name="JJK_CursedToolBase" ParentName="BaseMeleeWeapon_Sharp" Abstract="True">
    <techLevel>Medieval</techLevel>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <thingCategories Inherit="False">
      <li>WeaponsMelee</li>
    </thingCategories>
    <weaponTags>
      <li>JJK_CursedTool</li>
    </weaponTags>
    <tradeTags>
      <li>JJK_CursedTool</li>
    </tradeTags>
    <statBases>
      <MarketValue>650</MarketValue>
      <Mass>1.5</Mass>
    </statBases>
    <!-- Comp_CursedTool is declared per-weapon below (not here): def <comps>
         lists APPEND across inheritance, so a shared base comp would stack a
         duplicate onto every weapon that tunes its own values. -->
  </ThingDef>

  <!-- ===================== The one craftable cursed tool ================== -->
  <ThingDef ParentName="JJK_CursedToolBase">
    <defName>JJK_StandardCursedBlade</defName>
    <label>standard cursed blade</label>
    <description>A reliable, mass-producible cursed katana - the jujutsu world's safety net for spirit-fighting. Its cursed edge bites into spirits that shrug off ordinary steel, and it bites harder still channelling a sorcerer's cursed energy.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/CursedTools/StandardCursedBlade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>420</MarketValue>
      <Mass>1.4</Mass>
      <WorkToMake>1800</WorkToMake>
    </statBases>
    <costList>
      <JJK_CursedSteel>30</JJK_CursedSteel>
    </costList>
    <comps>
      <li Class="JJKMod.CompProperties_CursedTool">
        <ceOutputScaling>1.0</ceOutputScaling>
        <spiritBonusFactor>0.3</spiritBonusFactor>
      </li>
    </comps>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers>
        <li>JJK_CursedMaterialsBench</li>
      </recipeUsers>
      <researchPrerequisite>JJK_CursedToolForging</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <displayPriority>500</displayPriority>
    </recipeMaker>
    <tools>
      <li>
        <label>edge</label>
        <capacities><li>Cut</li></capacities>
        <power>20</power>
        <cooldownTime>2.0</cooldownTime>
        <armorPenetration>0.35</armorPenetration>
      </li>
      <li>
        <label>point</label>
        <capacities><li>Stab</li></capacities>
        <power>18</power>
        <cooldownTime>2.2</cooldownTime>
        <armorPenetration>0.32</armorPenetration>
      </li>
      <li>
        <label>pommel</label>
        <capacities><li>Blunt</li></capacities>
        <power>9</power>
        <cooldownTime>2.0</cooldownTime>
      </li>
    </tools>
  </ThingDef>

