    <description>A plain, immaculately maintained cursed katana in the style of Atsuya Kusakabe, master of the New Shadow Style. In the hands of a swordsman with no innate technique, discipline does what sorcery cannot - it cuts far harder.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/CursedTools/KusakabeKatana</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>720</MarketValue>
      <Mass>1.3</Mass>
    </statBases>
