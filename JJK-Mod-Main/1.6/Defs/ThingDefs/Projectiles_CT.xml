<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================================================================== -->
  <!-- Projectiles for the cursed techniques. Single-target projectiles use     -->
  <!-- TMF's ability-bullet base (TMF_BulletAbility_Base). Area-of-effect       -->
  <!-- projectiles use vanilla Projectile_Explosive with an explosionRadius.     -->
  <!-- Textures reuse vanilla projectile art (tinted) so everything is visible   -->
  <!-- without custom assets.                                                    -->
  <!-- ===================================================================== -->

  <!-- Shared abstract for AoE cursed projectiles. -->
  <ThingDef ParentName="BaseBullet" Name="JJK_ExplosiveProjectileBase" Abstract="True">
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <!-- Cursed technique AoE attacks are not grenade-style explosions; suppress
         the camera shake. Merged into each concrete projectile's properties. -->
    <projectile>
      <screenShakeFactor>0</screenShakeFactor>
    </projectile>
  </ThingDef>

