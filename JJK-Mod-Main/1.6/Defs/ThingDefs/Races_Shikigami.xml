  <!-- Mahoraga learns authored phenomena separately from conventional attacks.
       Basic physical damage cannot kill after one spin; complex techniques
       remain lethal through partial adaptation. Every spin fully regenerates. -->
  <ThingDef ParentName="JJK_ShikigamiRaceBase">
    <defName>JJK_Mahoraga</defName>
    <label>mahoraga</label>
    <description>The Eight-Handled Sword Divergent Sila Divine General Mahoraga, the strongest of the Ten Shadows. Its wheel studies each harmful phenomenon separately and fully restores its body whenever it turns. After the first spin, an adapted basic physical attack can no longer kill it. Complex cursed techniques remain lethal during partial adaptation; three spins normally bring complete immunity to that phenomenon. Repeated control effects and failed strikes against Infinity can also teach adaptation. Unfamiliar attacks remain dangerous. Learned adaptations last for this summon and survive saving and loading.</description>
    <statBases>
      <MoveSpeed>6.0</MoveSpeed>
      <!-- Existing durability is retained; full regeneration is the lore-first defense. -->
      <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.55</ArmorRating_Blunt>
      <ArmorRating_Heat>0.5</ArmorRating_Heat>
    </statBases>
    <tools>
      <li>
        <label>sword of extermination</label>
        <capacities><li>Cut</li></capacities>
        <power>32</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>1.4</chanceFactor>
        <armorPenetration>0.45</armorPenetration>
      </li>
      <li>
        <label>claws</label>
        <capacities><li>Scratch</li></capacities>
        <power>22</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
        <armorPenetration>0.3</armorPenetration>
      </li>
      <li>
        <label>wheel</label>
        <capacities><li>Blunt</li></capacities>
        <power>18</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <comps>
      <li Class="JJKMod.CompProperties_MahoragaAdaptation">
        <!-- Defaults can be overridden per phenomenon in MahoragaAdaptation.xml. -->
        <adaptDelayTicks>420</adaptDelayTicks>
        <maxLevel>3</maxLevel>
        <fullHealOnSpin>true</fullHealOnSpin>
        <basicDeathProtection>true</basicDeathProtection>
        <complexDeathProtection>false</complexDeathProtection>
      </li>
    </comps>
    <race>
      <!-- Concentrated damage can still kill before the relevant adaptation. -->
      <baseBodySize>1.7</baseBodySize>
      <baseHealthScale>4.0</baseHealthScale>
    </race>
  </ThingDef>

