  <ThingDef ParentName="JJK_CursedApparelBase">
    <defName>JJK_SixEyesCover</defName>
    <label>six eyes cover</label>
    <description>A blindfold of cursed cloth worn over the eyes. It blocks all ordinary sight - an ordinary pawn who wears it is simply blind. A Six Eyes bearer, whose perception flows from cursed energy rather than light, loses almost nothing.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/CursedApparel/SixEyesCover</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>200</MarketValue>
      <Mass>0.2</Mass>
      <WorkToMake>600</WorkToMake>
    </statBases>
    <costList>
      <JJK_CursedCloth>8</JJK_CursedCloth>
    </costList>
    <comps>
      <!-- Removes 100% of ordinary eyesight while worn (JJK_Blindfolded). The
           Six Eyes ocular organs (+150% sight each) more than cover the loss. -->
      <li Class="JJKMod.CompProperties_EquippedHediff">
        <hediff>JJK_Blindfolded</hediff>
      </li>
    </comps>
    <apparel>
      <bodyPartGroups>
        <li>Eyes</li>
      </bodyPartGroups>
      <layers>
        <li>EyeCover</li>
      </layers>
      <tags>
        <li>JJK_SorcererApparel</li>
      </tags>
      <wornGraphicPath>Things/Item/Equipment/CursedApparel/SixEyesCover_Worn</wornGraphicPath>
    </apparel>
  </ThingDef>

