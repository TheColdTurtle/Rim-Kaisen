<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================================================================== -->
  <!-- Mod-exclusive sorcerer apparel (Section 28). Crafted at the Cursed       -->
  <!-- Apparel Bench from cursed materials, these carry deeper enchantment than  -->
  <!-- vanilla apparel merely stuffed with the same materials: their buffs are   -->
  <!-- expressed as equippedStatOffsets on the cursed-energy stats (reserve,     -->
  <!-- regeneration, CT output).                                                 -->
  <!-- ===================================================================== -->

  <ThingDef Name="JJK_CursedApparelBase" ParentName="ApparelBase" Abstract="True">
    <techLevel>Industrial</techLevel>
    <tradeTags>
      <li>JJK_CursedApparel</li>
    </tradeTags>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <recipeUsers>
        <li>JJK_CursedApparelBench</li>
      </recipeUsers>
      <researchPrerequisite>JJK_CursedToolForging</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <displayPriority>500</displayPriority>
    </recipeMaker>
  </ThingDef>

  <!-- ======================= School uniforms =========================== -->
  <ThingDef ParentName="JJK_CursedApparelBase">
    <defName>JJK_TokyoUniform</defName>
    <label>Tokyo High uniform</label>
    <description>The dark uniform of Tokyo Jujutsu High. Woven from cursed cloth, it quickens the wearer's cursed energy recovery and broadens their reserve.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/CursedApparel/TokyoUniform</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>420</MarketValue>
      <Mass>1.2</Mass>
      <WorkToMake>1800</WorkToMake>
      <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.06</ArmorRating_Blunt>
      <Insulation_Cold>16</Insulation_Cold>
    </statBases>
    <costList>
      <JJK_CursedCloth>35</JJK_CursedCloth>
      <Cloth>20</Cloth>
    </costList>
    <equippedStatOffsets>
      <JJK_CursedEnergyRegenRateMultiplier>0.15</JJK_CursedEnergyRegenRateMultiplier>
      <JJK_MaxCursedEnergy>20</JJK_MaxCursedEnergy>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>JJK_SorcererApparel</li>
      </tags>
      <wornGraphicPath>Things/Item/Equipment/CursedApparel/TokyoUniform_Worn</wornGraphicPath>
    </apparel>
  </ThingDef>

