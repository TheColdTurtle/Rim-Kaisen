  <TaranMagicFramework.AbilityDef ParentName="JJK_BloodManipulationBase">
    <defName>JJK_Convergence</defName>
    <label>convergence</label>
    <description>Spend one second compressing blood. For 15 seconds, your next Piercing Blood gains 40% damage and stronger penetration, or your next Supernova gains damage and radius. The preparation is consumed by one successful attack and cannot stack.</description>
    <uiPosition>(0.7, 0.6)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/Supernova</uiSkillIcon>
    <abilityClass>JJKMod.Ability_LegacyTechnique</abilityClass>
    <modExtensions>
      <li Class="JJKMod.LegacyMoveExtension">
        <move>Convergence</move>
        <radius>0</radius>
      </li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_Convergence_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>
