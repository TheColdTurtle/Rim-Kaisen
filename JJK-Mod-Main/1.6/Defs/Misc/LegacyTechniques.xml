<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <TaranMagicFramework.AbilityDef ParentName="JJK_DisasterPlantsBase">
    <defName>JJK_CursedBuds</defName>
    <label>cursed buds</label>
    <description>Embed energy-feeding buds in an enemy for 15 seconds. Each completed paid cursed-energy cast feeds the buds: they drain an extra 25% of that cast's cost (1-10 CE) and grow, at most once per second. Movement falls by 10%, then 25%, then 40%. Free controls do not feed them. Recasting refreshes duration without stacking another parasite. An enemy can stop casting and wait for the buds to wither.</description>
    <uiPosition>(0.25, 0.6)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/Roots</uiSkillIcon>
    <abilityClass>JJKMod.Ability_LegacyTechnique</abilityClass>
    <modExtensions>
      <li Class="JJKMod.LegacyMoveExtension">
        <move>CursedBuds</move>
        <radius>0</radius>
      </li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_CursedBuds_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>
  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_CursedBuds_Tier1</defName>
    <label>cursed buds</label>
    <acquireRequirement>
      <minLevel>1</minLevel>
      <requiredGenes>
        <li>JJK_CT_Gene_DisasterPlants</li>
      </requiredGenes>
    </acquireRequirement>
    <energyCost>25</energyCost>
    <cooldownTicks>600</cooldownTicks>
    <castDurationTicks>30</castDurationTicks>
    <effectRadius>16</effectRadius>
    <requireLineOfSight>true</requireLineOfSight>
    <aiAbilityWorker>TaranMagicFramework.AIAbilityWorker_TargetHostile</aiAbilityWorker>
    <targetingParameters>
      <canTargetPawns>true</canTargetPawns>
      <canTargetLocations>false</canTargetLocations>
      <canTargetSelf>false</canTargetSelf>
    </targetingParameters>
  </TaranMagicFramework.AbilityTierDef>
  <TaranMagicFramework.AbilityDef ParentName="JJK_DisasterPlantsBase">
    <defName>JJK_FlowerField</defName>
    <label>flower field</label>
    <description>Bloom a distracting flower field in a fixed 4-cell area. Eight pulses one second apart reduce enemies' shooting accuracy and melee hit chance by 30%. The distraction fades 1.5 seconds after leaving the flowers. One field per caster; losing the technique or becoming unable to sustain it ends the field.</description>
    <uiPosition>(0.75, 0.6)</uiPosition>
    <uiSkillIcon>UI/Icons/CursedTechniques/HugeRoots</uiSkillIcon>
    <abilityClass>JJKMod.Ability_LegacyTechnique</abilityClass>
    <modExtensions>
      <li Class="JJKMod.LegacyMoveExtension">
        <move>FlowerField</move>
        <radius>4</radius>
      </li>
    </modExtensions>
    <abilityTiers>
      <li>JJK_FlowerField_Tier1</li>
    </abilityTiers>
  </TaranMagicFramework.AbilityDef>
  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase">
    <defName>JJK_FlowerField_Tier1</defName>
    <label>flower field</label>
    <acquireRequirement>
