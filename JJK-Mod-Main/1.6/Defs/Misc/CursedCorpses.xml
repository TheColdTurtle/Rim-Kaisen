  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase"><defName>JJK_Puppet_UltraCannon</defName><label>ultra cannon</label><description>Order the nearest ready controlled Mechamaru to fire at an enemy within 26 tiles of the puppet. Costs 6 core charge; 24 burn damage, 180-tick puppet cooldown. The controller needs no line of sight.</description><uiPosition>(0.25, 0.3)</uiPosition><uiSkillIcon>UI/Icons/CursedTechniques/ReleaseCurse</uiSkillIcon><abilityClass>JJKMod.Ability_PuppetOrder</abilityClass><abilityTrees><li>JJK_CT_PuppetManipulation</li></abilityTrees><modExtensions><li Class="JJKMod.PuppetAbilityExtension"><move>UltraCannon</move></li></modExtensions><abilityTiers><li>JJK_Puppet_UltraCannon_Tier</li></abilityTiers></TaranMagicFramework.AbilityDef>
  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase"><defName>JJK_Puppet_UltraCannon_Tier</defName><label>ultra cannon</label><acquireRequirement><minLevel>0</minLevel><requiredGenes><li>JJK_CT_Gene_PuppetManipulation</li></requiredGenes></acquireRequirement><energyCost>0</energyCost><cooldownTicks>30</cooldownTicks><castDurationTicks>10</castDurationTicks><effectRadius>500</effectRadius><requireLineOfSight>false</requireLineOfSight><targetingParameters><canTargetPawns>true</canTargetPawns><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters></TaranMagicFramework.AbilityTierDef>
  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase"><defName>JJK_Puppet_UltraSpin</defName><label>ultra spin</label><description>Order a controlled Mechamaru adjacent to an enemy to drill into it. Range 1.9 from puppet, 40 stab damage, 15 core charge; shares the 180-tick Ultra Cannon cooldown.</description><uiPosition>(0.5, 0.3)</uiPosition><uiSkillIcon>UI/Icons/CursedTechniques/ReleaseCurse</uiSkillIcon><abilityClass>JJKMod.Ability_PuppetOrder</abilityClass><abilityTrees><li>JJK_CT_PuppetManipulation</li></abilityTrees><modExtensions><li Class="JJKMod.PuppetAbilityExtension"><move>UltraSpin</move></li></modExtensions><abilityTiers><li>JJK_Puppet_UltraSpin_Tier</li></abilityTiers></TaranMagicFramework.AbilityDef>
  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase"><defName>JJK_Puppet_UltraSpin_Tier</defName><label>ultra spin</label><acquireRequirement><minLevel>1</minLevel><requiredGenes><li>JJK_CT_Gene_PuppetManipulation</li></requiredGenes></acquireRequirement><energyCost>0</energyCost><cooldownTicks>30</cooldownTicks><castDurationTicks>10</castDurationTicks><effectRadius>500</effectRadius><requireLineOfSight>false</requireLineOfSight><targetingParameters><canTargetPawns>true</canTargetPawns><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters></TaranMagicFramework.AbilityTierDef>
  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase"><defName>JJK_Puppet_UltraShield</defName><label>ultra shield</label><description>Target your Mechamaru puppet to reduce its incoming damage by 45% for 600 ticks. Costs 20 core charge; shares a 900-tick cooldown with Boost On.</description><uiPosition>(0.75, 0.3)</uiPosition><uiSkillIcon>UI/Icons/CursedTechniques/ReleaseCurse</uiSkillIcon><abilityClass>JJKMod.Ability_PuppetOrder</abilityClass><abilityTrees><li>JJK_CT_PuppetManipulation</li></abilityTrees><modExtensions><li Class="JJKMod.PuppetAbilityExtension"><move>UltraShield</move></li></modExtensions><abilityTiers><li>JJK_Puppet_UltraShield_Tier</li></abilityTiers></TaranMagicFramework.AbilityDef>
  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase"><defName>JJK_Puppet_UltraShield_Tier</defName><label>ultra shield</label><acquireRequirement><minLevel>1</minLevel><requiredGenes><li>JJK_CT_Gene_PuppetManipulation</li></requiredGenes></acquireRequirement><energyCost>0</energyCost><cooldownTicks>30</cooldownTicks><castDurationTicks>10</castDurationTicks><effectRadius>500</effectRadius><requireLineOfSight>false</requireLineOfSight><targetingParameters><canTargetPawns>true</canTargetPawns><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters></TaranMagicFramework.AbilityTierDef>
  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase"><defName>JJK_Puppet_BoostOn</defName><label>boost on</label><description>Target your Mechamaru puppet to boost movement speed by 40% for 600 ticks. Costs 12 core charge; shares a 900-tick cooldown with Ultra Shield.</description><uiPosition>(0.25, 0.6)</uiPosition><uiSkillIcon>UI/Icons/CursedTechniques/ReleaseCurse</uiSkillIcon><abilityClass>JJKMod.Ability_PuppetOrder</abilityClass><abilityTrees><li>JJK_CT_PuppetManipulation</li></abilityTrees><modExtensions><li Class="JJKMod.PuppetAbilityExtension"><move>BoostOn</move></li></modExtensions><abilityTiers><li>JJK_Puppet_BoostOn_Tier</li></abilityTiers></TaranMagicFramework.AbilityDef>
  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase"><defName>JJK_Puppet_BoostOn_Tier</defName><label>boost on</label><acquireRequirement><minLevel>0</minLevel><requiredGenes><li>JJK_CT_Gene_PuppetManipulation</li></requiredGenes></acquireRequirement><energyCost>0</energyCost><cooldownTicks>30</cooldownTicks><castDurationTicks>10</castDurationTicks><effectRadius>500</effectRadius><requireLineOfSight>false</requireLineOfSight><targetingParameters><canTargetPawns>true</canTargetPawns><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters></TaranMagicFramework.AbilityTierDef>
  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase"><defName>JJK_Puppet_UltimateCannon</defName><label>ultimate cannon</label><description>Order the nearest ready Mechamaru to fire its Mode: Albatross finisher at an enemy within 32 tiles of the puppet. Costs 60 core charge; 70 explosive damage in a 2.9-tile radius, with friendly fire. Requires a Grade 1 controller. 1,800-tick puppet cooldown.</description><uiPosition>(0.5, 0.6)</uiPosition><uiSkillIcon>UI/Icons/CursedTechniques/ReleaseCurse</uiSkillIcon><abilityClass>JJKMod.Ability_PuppetOrder</abilityClass><abilityTrees><li>JJK_CT_PuppetManipulation</li></abilityTrees><modExtensions><li Class="JJKMod.PuppetAbilityExtension"><move>UltimateCannon</move></li></modExtensions><abilityTiers><li>JJK_Puppet_UltimateCannon_Tier</li></abilityTiers></TaranMagicFramework.AbilityDef>
  <TaranMagicFramework.AbilityTierDef ParentName="JJK_AbilityTierBase"><defName>JJK_Puppet_UltimateCannon_Tier</defName><label>ultimate cannon</label><acquireRequirement><minLevel>3</minLevel><requiredGenes><li>JJK_CT_Gene_PuppetManipulation</li></requiredGenes></acquireRequirement><energyCost>0</energyCost><cooldownTicks>30</cooldownTicks><castDurationTicks>10</castDurationTicks><effectRadius>500</effectRadius><requireLineOfSight>false</requireLineOfSight><targetingParameters><canTargetPawns>true</canTargetPawns><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters></TaranMagicFramework.AbilityTierDef>
  <TaranMagicFramework.AbilityDef ParentName="JJK_AbilityBase"><defName>JJK_Puppet_RemoteRecharge</defName><label>remote recharge</label><description>Target one of your bound constructs on this map to transfer 30 CE into 60 core charge. Core must hold 60 or less of its 120 maximum. Transfers energy without requiring the controller to walk to the puppet.</description><uiPosition>(0.75, 0.6)</uiPosition><uiSkillIcon>UI/Icons/CursedTechniques/ReleaseCurse</uiSkillIcon><abilityClass>JJKMod.Ability_PuppetOrder</abilityClass><abilityTrees><li>JJK_CT_PuppetManipulation</li></abilityTrees><modExtensions><li Class="JJKMod.PuppetAbilityExtension"><recharge>true</recharge></li></modExtensions><abilityTiers><li>JJK_Puppet_RemoteRecharge_Tier</li></abilityTiers></TaranMagicFramework.AbilityDef>
