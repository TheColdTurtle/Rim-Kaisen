<Defs>
  <!-- Canon names with explicit gameplay adaptations: finite stockpiles replace years of CE, and sister-core attacks are unknown in canon. -->
  <ResearchProjectDef>
    <defName>JJK_IndependentCores</defName>
    <label>independent cursed corpse cores</label>
    <description>Construct three compatible soul-information cores and a Panda-type cursed corpse. The cores mature over three RimWorld quadrums (45 days), then replenish their own energy. Does not resurrect the people whose information the core patterns represent.</description>
    <tab>JJK_Jujutsu</tab>
    <prerequisites>
      <li>JJK_CursedCorpseConstruction</li>
      <li>JJK_ReverseCursedTechnique</li>
    </prerequisites>
    <baseCost>6000</baseCost>
    <techLevel>Spacer</techLevel>
    <researchViewX>4</researchViewX>
    <researchViewY>3.6</researchViewY>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>JJK_PuppetEngineering</defName>
    <label>advanced puppet engineering</label>
    <description>Construct Mode: Absolute frames and communication puppets. Giant frames require a Grade 1 Puppet Manipulation pilot and a stored-energy supply; their year-named attacks spend numerical energy reserves in this adaptation.</description>
    <tab>JJK_Jujutsu</tab>
    <prerequisites>
