      <li>JJK_AdvancedCursedMaterials</li>
    </prerequisites>
    <baseCost>5000</baseCost>
    <techLevel>Spacer</techLevel>
    <researchViewX>4</researchViewX>
    <researchViewY>2.4</researchViewY>
  </ResearchProjectDef>
