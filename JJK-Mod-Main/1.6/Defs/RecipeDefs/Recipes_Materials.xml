<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Cursed material refining recipes, performed at the Cursed Materials Bench. -->

  <RecipeDef>
    <defName>JJK_Make_CursedSteel</defName>
    <label>refine cursed steel</label>
    <description>Temper steel in cursed residue to produce cursed steel.</description>
    <jobString>Refining cursed steel.</jobString>
    <workAmount>1400</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <recipeUsers>
      <li>JJK_CursedMaterialsBench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter><thingDefs><li>Steel</li></thingDefs></filter>
        <count>20</count>
      </li>
      <li>
        <filter><thingDefs><li>JJK_CursedResidue</li></thingDefs></filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>JJK_CursedResidue</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <JJK_CursedSteel>20</JJK_CursedSteel>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
  </RecipeDef>

  <RecipeDef>
    <defName>JJK_Make_CursedCloth</defName>
    <label>weave cursed cloth</label>
    <description>Weave cloth through with cursed energy to produce cursed cloth.</description>
    <jobString>Weaving cursed cloth.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <recipeUsers>
      <li>JJK_CursedMaterialsBench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter><thingDefs><li>Cloth</li></thingDefs></filter>
        <count>25</count>
      </li>
      <li>
        <filter><thingDefs><li>JJK_CursedResidue</li></thingDefs></filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Cloth</li>
        <li>JJK_CursedResidue</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <JJK_CursedCloth>25</JJK_CursedCloth>
    </products>
    <skillRequirements>
      <Crafting>3</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
  </RecipeDef>

  <!-- Cursed Bio-Ferrite: Bioferrite x8 + Cursed Residue x6 -> 8, work 1800.
       Requires Anomaly (Bioferrite). -->
  <RecipeDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>JJK_Make_CursedBioFerrite</defName>
    <label>saturate cursed bio-ferrite</label>
    <description>Saturate bioferrite with cursed residue to produce cursed bio-ferrite.</description>
    <jobString>Saturating cursed bio-ferrite.</jobString>
    <workAmount>1800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <recipeUsers>
      <li>JJK_CursedMaterialsBench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter><thingDefs><li>Bioferrite</li></thingDefs></filter>
        <count>8</count>
      </li>
      <li>
        <filter><thingDefs><li>JJK_CursedResidue</li></thingDefs></filter>
        <count>6</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Bioferrite</li>
        <li>JJK_CursedResidue</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <JJK_CursedBioFerrite>8</JJK_CursedBioFerrite>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
  </RecipeDef>

  <RecipeDef>
    <defName>JJK_Make_CursedLeather</defName>
    <label>cure cursed leather</label>
    <description>Cure leather in cursed residue to produce cursed leather.</description>
    <jobString>Curing cursed leather.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <recipeUsers>
      <li>JJK_CursedMaterialsBench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter><categories><li>Leathers</li></categories></filter>
        <count>25</count>
      </li>
      <li>
        <filter><thingDefs><li>JJK_CursedResidue</li></thingDefs></filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories><li>Leathers</li></categories>
      <thingDefs><li>JJK_CursedResidue</li></thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories><li>Leathers</li></categories>
      <thingDefs><li>JJK_CursedResidue</li></thingDefs>
    </defaultIngredientFilter>
    <products>
      <JJK_CursedLeather>25</JJK_CursedLeather>
    </products>
    <skillRequirements>
      <Crafting>3</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
  </RecipeDef>

  <!-- Cursed Devilstrand: top fabric, gated behind advanced cursed materials. -->
  <RecipeDef>
    <defName>JJK_Make_CursedDevilstrand</defName>
    <label>infuse cursed devilstrand</label>
    <description>Infuse devilstrand with cursed residue to produce cursed devilstrand.</description>
    <jobString>Infusing cursed devilstrand.</jobString>
    <workAmount>2000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <researchPrerequisite>JJK_AdvancedCursedMaterials</researchPrerequisite>
    <recipeUsers>
      <li>JJK_CursedMaterialsBench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter><thingDefs><li>DevilstrandCloth</li></thingDefs></filter>
        <count>20</count>
      </li>
      <li>
        <filter><thingDefs><li>JJK_CursedResidue</li></thingDefs></filter>
        <count>8</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>DevilstrandCloth</li>
        <li>JJK_CursedResidue</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <JJK_CursedDevilstrand>20</JJK_CursedDevilstrand>
    </products>
    <skillRequirements>
      <Crafting>7</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
  </RecipeDef>

</Defs>
