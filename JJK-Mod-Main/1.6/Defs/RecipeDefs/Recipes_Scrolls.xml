<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef>
    <defName>JJK_WriteNewShadowStyleScroll</defName>
    <label>write scroll: new shadow style</label>
    <description>Transcribe a single-use new shadow style training scroll on cloth infused with cursed residue. Research and Intellectual skill are required to write it; a sorcerer must still read the finished scroll to learn its ability.</description>
    <jobString>Writing a new shadow style scroll.</jobString>
    <workAmount>6000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <recipeUsers>
      <li>JJK_CursedMaterialsBench</li>
    </recipeUsers>
    <researchPrerequisites>
      <li>JJK_ScrollTranscription</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Cloth</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>JJK_CursedResidue</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Cloth</li>
        <li>JJK_CursedResidue</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <JJK_NewShadowStyleScroll>1</JJK_NewShadowStyleScroll>
    </products>
    <skillRequirements>
      <Intellectual>6</Intellectual>
    </skillRequirements>
  </RecipeDef>
